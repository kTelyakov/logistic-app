{
  "name": "logistic-crm",
  "private": true,
  "type": "module",
  "workspaces": [
    "contract",
    "mock"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "mock": "npm run start -w @dispatch/mock",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint .",
    "cycles": "node tools/lint/cycles.mjs",
    "check": "npm run typecheck && npm run lint && npm run cycles",
    "e2e:stress": "playwright test -c playwright.stress.config.ts"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
