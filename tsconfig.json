{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "node"],
    "jsx": "preserve",
    "noEmit": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["contract/src/**/*.ts", "src/**/*.ts", "src/**/*.vue", "vite.config.ts", "tests/**/*.ts", "env.d.ts"]
}
